PORT=4000

# Local
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lupo_tracking

# Railway MySQL (alternativa: el backend también lee MYSQLHOST, MYSQLPORT, etc.)
# DB_HOST=${{MySQL.MYSQLHOST}}
# DB_PORT=${{MySQL.MYSQLPORT}}
# DB_USER=${{MySQL.MYSQLUSER}}
# DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
# DB_NAME=${{MySQL.MYSQLDATABASE}}

JWT_SECRET=cambiar-en-produccion

# Orígenes extra (opcional). Por defecto ya se permiten localhost, Vercel y enviosposta.com.ar.
# CORS_ORIGIN=http://localhost:5173,https://www.enviosposta.com.ar
FRONTEND_URL=https://www.enviosposta.com.ar

# Railway: poné true UNA vez, redeployá el backend, y después volvelo a false o borralo
DB_RESET_ON_START=false

# Carga el perfil demo (ag_demo) sin borrar datos reales de otras agencias. Útil en producción.
# DEMO_SEED_ON_START=true

# URL pública del backend (OAuth + webhook ML). En Railway se infiere de RAILWAY_PUBLIC_DOMAIN si no está definida.
PUBLIC_URL=http://localhost:4000
# PUBLIC_URL=https://envios-erp.up.railway.app

# App móvil Android (opcional; por defecto se lee backend/downloads/app-version.json)

# Vincular cuentas fijas de MensajeriaGR (gabriel/lupo) a ag_default al arrancar.
# Dejar vacío o 0 en entornos multi-agencia para no mezclar repartidores.
# SYNC_MENSAJERIA_GR=1
# MOBILE_APP_VERSION=1.0.0
# MOBILE_APP_MIN_VERSION=1.0.0
# MOBILE_APP_SCHEME=lupo

# Log GPS repartidor en Railway (Deploy → Logs). Filtrar por nombre/username opcional.
# REPARTIDOR_GPS_LOG=true
# REPARTIDOR_GPS_LOG_FILTER=ariel
FRONTEND_URL=http://localhost:5173

# Correo transaccional (recuperación de contraseña). Sin API key, el link se imprime en los logs del backend.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=Posta <noreply@enviosposta.com.ar>

# Mercado Libre
ML_APP_ID=
ML_APP_SECRET=
# Site de Mercado Libre (MLA = Argentina). Usado al registrar escaneos Flex de mensajería.
# ML_SITE_ID=MLA
# ML_REDIRECT_URI=http://localhost:4000/api/integrations/mercadolibre/callback
# En Mercado Libre → Notificaciones callbacks URL y tópicos:
#   URL: https://TU-BACKEND/api/integrations/mercadolibre/notifications
#   Tópicos: orders_v2, shipments, flex-handshakes
# Flujo Flex documentado:
#   shipments → GET https://api.mercadolibre.com/shipments/$SHIPMENT_ID
#   flex-handshakes → GET .../flex/sites/$SITE_ID/shipments/$SHIPMENT_ID/assignment/v1
#   missed_feeds (opcional, solo dueño de la app ML) → ML_APP_OWNER_ACCESS_TOKEN
# ML_APP_OWNER_ACCESS_TOKEN=

# Tienda Nube — https://partners.tiendanube.com
TN_APP_ID=
TN_APP_SECRET=
# TN_REDIRECT_URI=http://localhost:4000/api/integrations/tiendanube/callback
# Webhooks LGPD (obligatorios en el panel de partners):
# https://TU-BACKEND/api/integrations/tiendanube/webhooks/store-redact
# https://TU-BACKEND/api/integrations/tiendanube/webhooks/customers-redact
# https://TU-BACKEND/api/integrations/tiendanube/webhooks/customers-data-request

# Shopify — https://partners.shopify.com (app Partner / Dev Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# SHOPIFY_API_VERSION=2026-07
# SHOPIFY_SCOPES=read_orders
# SHOPIFY_REDIRECT_URI=http://localhost:4000/api/integrations/shopify/callback
# Webhooks de pedidos (se registran al conectar):
#   https://TU-BACKEND/api/integrations/shopify/webhooks/orders
# Compliance (obligatorios si publicás en App Store; configurar en shopify.app.toml / Partner Dashboard):
#   https://TU-BACKEND/api/integrations/shopify/webhooks/customers-data-request
#   https://TU-BACKEND/api/integrations/shopify/webhooks/customers-redact
#   https://TU-BACKEND/api/integrations/shopify/webhooks/shop-redact
# SHOPIFY_AUTO_IMPORT_LOOKBACK_DAYS=14
# SHOPIFY_AUTO_IMPORT_INTERVAL_MS=300000

# WooCommerce — el vendedor pega URL + Consumer Key/Secret (WooCommerce → Ajustes → Avanzado → REST API)
# No requiere secrets globales en el servidor.
# Webhooks (se crean al conectar):
#   https://TU-BACKEND/api/integrations/woocommerce/webhooks/orders
# WOO_AUTO_IMPORT_LOOKBACK_DAYS=14
# WOO_AUTO_IMPORT_INTERVAL_MS=300000

# Mercado Pago — https://www.mercadopago.com.ar/developers
# OAuth: cada agencia conecta su cuenta para cobrar envíos a vendedores
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# MP_REDIRECT_URI=http://localhost:4000/api/mercadopago/oauth/callback
# Webhook único (suscripciones + pagos de vendedores): https://TU-BACKEND/api/mercadopago/webhooks

# Token de la cuenta Posta para cobrar suscripciones a agencias
POSTA_MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
# SUBSCRIPTION_TRIAL_DAYS=14

# Agendar demo (Google Calendar + Meet)
# Opción A — cuenta de servicio: compartí el calendario con el email de la SA (permiso " hacer cambios en eventos")
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Opción B — OAuth (recomendado con Gmail personal): refresh token del dueño del calendario
# GOOGLE_CLIENT_ID=   # También habilita “Continuar con Google” en el login/registro (cliente Web + orígenes autorizados)
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary
# DEMO_TIMEZONE=America/Argentina/Buenos_Aires
# DEMO_SLOT_MINUTES=30
# DEMO_WORKDAY_START=9
# DEMO_WORKDAY_END=18
# DEMO_BOOKING_DAYS_AHEAD=14
