{
  "expo": {
    "name": "Posta",
    "slug": "posta-repartidor",
    "version": "1.3.0",
    "orientation": "portrait",
    "scheme": "lupo",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141210",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#141210"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/66fe0c44-a8c0-428b-babf-e5de345b6ecd",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.postaenvios.repartidor",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Posta requiere tu ubicación para que puedas usar la app como repartidor y compartir tu posición con logística.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Posta requiere tu ubicación todo el tiempo para el seguimiento en vivo de la flota, con o sin envío activo.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "versionCode": 16,
      "package": "com.postaenvios.repartidor",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "lupo",
              "host": "oauth",
              "pathPrefix": "/callback"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#141210"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "expo-task-manager",
      [
        "expo-camera",
        {
          "cameraPermission": "Posta usa la cámara para escanear las etiquetas de Mercado Libre Flex."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Posta requiere tu ubicación para que puedas usar la app como repartidor.",
          "locationAlwaysAndWhenInUsePermission": "Posta requiere tu ubicación todo el tiempo para el seguimiento en vivo de la flota.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C45C26",
          "defaultChannel": "posta-alerts"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://envios-erp.up.railway.app",
      "eas": {
        "projectId": "66fe0c44-a8c0-428b-babf-e5de345b6ecd"
      }
    }
  }
}
