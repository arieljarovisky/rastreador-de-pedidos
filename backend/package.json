{
  "name": "lupo-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "node ./node_modules/typescript/lib/tsc.js && node -e \"require('fs').mkdirSync('dist/db',{recursive:true});require('fs').copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "db:setup": "tsx src/db/setup.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:seed": "tsx src/db/seed-only.ts",
    "demo:pdf": "tsx scripts/generate-demo-pdf.ts",
    "db:sync-agency": "tsx src/db/sync-agency-bindings.ts",
    "db:clone-prod": "tsx src/db/clone-prod-database.ts",
    "db:reset:prod": "node dist/db/reset.js",
    "db:clear-orders": "tsx src/db/clear-orders.ts",
    "db:purge-legacy-zones": "tsx src/db/purge-legacy-zones.ts",
    "db:reset-password": "tsx src/db/reset-password.ts",
    "db:migrate-equal-prices": "tsx scripts/migrate-equal-prices-and-delete-payment.ts",

    "google:token": "tsx scripts/get-google-calendar-token.ts",
    "lint": "node ./node_modules/typescript/lib/tsc.js --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.14.1",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "typescript": "~5.8.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.21.0"
  }
}
